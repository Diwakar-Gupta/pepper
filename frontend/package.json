{
  "name": "pepper-frontend",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "homepage": "https://diwakar-gupta.github.io/pepper/",
  "scripts": {
    "start": "parcel index.html --public-url /pepper/",
    "build": "parcel build index.html --public-url /pepper/ && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "deploy": "yarn build && gh-pages -d dist"
  },
  "devDependencies": {
    "gh-pages": "^6.1.1",
    "parcel": "^2.15.4",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-ace": "^10.1.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "ace-builds": "1.45.2"
  },
  "staticFiles": {
    "staticPath": "public"
  },
  "resolutions": {
    "ace-builds": "1.45.2"
  }
}
